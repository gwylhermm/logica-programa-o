algoritmo "Sistema-pedidos"

var
  opcao: inteiro

inicio
  escreval("digite o numero do produto desejado [1a5]:")
  escreval("1- X-Burguer")
  escreval("2- Pizza")
  escreval("3- Batata")
  escreval("4- Refrigerante")
  escreval("5- Sorvete")
  leia(opcao)
  escreval("=================")

  escolha opcao
    caso 1
      escreval("produto escolhido: X-burguer")
      escreval("Preço: R$34.99")
    caso 2
      escreval("produto escolhido: Pizza")
      escreval("Preço: R$49.99")
    caso 3
      escreval("produto escolhido: Batata")
      escreval("Preço: R$24.99")
    caso 4
      escreval("produto escolhido: Refrigerante")
      escreval("Preço: R$9.99")
    caso 5
      escreval("produto escolhido: Sorvete")
      escreval("Preço: R$4.99")
    outrocaso
      escreval("Opção inválida!")          
  fimescolha

fimalgoritmo